digraph workflow {
  graph [rankdir=TB, bgcolor="white", pad="0.28", nodesep="0.30", ranksep="0.34", fontname="PingFang SC", labelloc="t", label="组织史部门编码与审核完整流程（分步版）", fontsize=25, fontcolor="#17324d"];
  node [shape=box, style="rounded,filled", fontname="PingFang SC", fontsize=12, margin="0.16,0.10", color="#477b9d", fillcolor="#f5f9fc", fontcolor="#17324d"];
  edge [fontname="PingFang SC", fontsize=10, color="#55758b", arrowsize=0.7];
  raw [label="输入原始 Excel", fillcolor="#dceefa", color="#2878a8", penwidth=2];
  cbfile [label="输入 codebook.xlsx", fillcolor="#dceefa", color="#2878a8", penwidth=2];
  cfg [label="进入首次运行配置", fillcolor="#eaf4fb"]; cfgcb [label="填写 codebook 路径"]; cfgraw [label="填写原始数据路径"]; cfgstart [label="填写年鉴起点年月\n用于补充缺失任职年月"]; cfgend [label="填写年鉴终点年月\n用于补充缺失任职年月"]; cfgllm [label="选择是否使用 DeepSeek"];
  read [label="读取原始数据与 codebook", fillcolor="#eef7f0", color="#4c8c68"];
  idxname [label="建立标准名称索引\ncodebook.w_name"]; idxalias [label="建立 alias 索引\ncodebook.alias"]; idxscope [label="建立地域范围索引\ncityname / distname"]; idxperiod [label="建立有效期记录索引\nyear/month valid from/to"]; idxrank [label="建立部门级别与类别索引\nwrank / s1_sector"];
  card [label="第一遍人工审核入口", fillcolor="#fff5df", color="#c58a24", penwidth=2]; merge [label="按 w_name_o 合并重复记录"]; candidate [label="生成候选卡片"]; choosew [label="人工选择标准 w_name"]; chooses [label="人工选择 s1_sector"]; chooser [label="人工选择 wrank_t"]; pending [label="审核结果进入暂存区"]; save1 [label="保存本批审核结果", fillcolor="#fff5df", color="#c58a24", penwidth=2]; stage1 [label="生成阶段文件\n人工复核完成.xlsx", fillcolor="#dceefa", color="#2878a8", penwidth=2]; upload1 [label="重新上传人工复核完成文件"];
  scope [label="按照 codebook 自动确定审核范围", fillcolor="#eef7f0", color="#4c8c68"]; city [label="读取输入数据 cityname"]; dist [label="读取输入数据 distname"]; filter [label="只保留与 codebook 范围匹配的记录"]; lookup [label="检查当前 w_name 对应的 codebook 记录"]; valid [shape=diamond, label="是否存在有效期变化？", fillcolor="#fff5df", color="#c58a24", penwidth=2];
  nochange [label="分流 1：没有有效期变化", fillcolor="#f3f0ff", color="#7764a8", penwidth=2]; cover [label="用 wrank_t 覆盖 wrank20"]; keep [label="保留原始其他字段"]; stage_no [label="生成无变化部门阶段文件", fillcolor="#dceefa", color="#2878a8"];
  changed [label="分流 2：存在有效期变化", fillcolor="#f3f0ff", color="#7764a8", penwidth=2]; backfill [label="按年鉴起止年月补充缺失\nstyr / stmo / fiyr / fimo"]; periodmatch [label="按照 codebook 有效期匹配\nw_name / s1_sector / wrank_t"]; interval [label="判断任职区间是否跨越变化节点"]; stablepart [label="任职区间未跨节点\n直接使用对应有效期段"]; crosspart [label="任职区间跨越节点\n进入扩行处理"]; duplicate [label="复制变化节点所在 year 行"]; before [label="复制行及其以上记录\n填写变化前信息"]; after [label="复制行以下记录\n填写变化后信息"]; fillfields [label="填写变化前后\nw_name / s1_sector / wrank_t"]; restore [label="恢复原始缺失任职年月\n保留扩行边界与拆分日志"]; fill20 [label="根据覆盖 2020 年的有效期段\n填充 wrank20", fillcolor="#f3f0ff", color="#7764a8", penwidth=2]; stage2 [label="生成部门扩充阶段文件\n处理结果 / 问题清单 / 拆分日志", fillcolor="#dceefa", color="#2878a8", penwidth=2]; upload2 [label="上传本次阶段性文件"];
  post [label="进入 post_rank 预审与匹配", fillcolor="#fff5df", color="#c58a24", penwidth=2]; getwrank [label="读取当前 wrank_t"]; getpost1 [label="读取 post1 职位名称"]; classify [label="用 4post_rank.R 四组职位词表分类\n部门党政领导 / 部门副领导\n二级局党政领导 / 二级局副手"]; rankmap [label="结合 wrank_t 与职位类别\n推导理论 rank1 / rank2 / rank3 / rank4"]; infer [label="生成理论 post_rank"]; compare [label="与原始 post_rank 比较"]; known [shape=diamond, label="职位是否能够识别？", fillcolor="#fff5df", color="#c58a24", penwidth=2]; same [label="能够识别且一致\n标记为一致", fillcolor="#eef7f0", color="#4c8c68"]; conflict [label="能够识别但不一致\n写入 post_rank 人工审核队列", fillcolor="#fff0ed", color="#b85c4b"]; unknown [label="职位名称无法识别\n写入未知职位人工定级界面", fillcolor="#fff0ed", color="#b85c4b"]; unknownrank [label="wrank_t 无法识别\n写入部门级别无法判断队列", fillcolor="#fff0ed", color="#b85c4b"]; resultpost [label="生成 post_rank 审核结果文件", fillcolor="#dceefa", color="#2878a8", penwidth=2]; manualpost [label="人工查看并修改原始 Excel", fillcolor="#fff5df", color="#c58a24", penwidth=2]; uploadpost [label="上传人工修改后的 post_rank 文件"];
  check [label="执行最终一致性检查", fillcolor="#eef7f0", color="#4c8c68", penwidth=2]; checkw [label="检查 w_name"]; checks [label="检查 s1_sector"]; checkr [label="检查 wrank_t"]; check20 [label="检查 wrank20"]; checkpost [label="检查 post_rank"]; final [label="生成最终成稿 Excel", fillcolor="#dceefa", color="#2878a8", penwidth=2];
  raw -> cfg; cbfile -> cfg; cfg -> cfgcb -> cfgraw -> cfgstart -> cfgend -> cfgllm -> read; read -> idxname -> idxalias -> idxscope -> idxperiod -> idxrank -> card; card -> merge -> candidate -> choosew -> chooses -> chooser -> pending -> save1 -> stage1 -> upload1; upload1 -> scope -> city -> dist -> filter -> lookup -> valid; valid -> nochange [label="否"]; nochange -> cover -> keep -> stage_no -> upload2; valid -> changed [label="是"]; changed -> backfill -> periodmatch -> interval; interval -> stablepart -> fillfields; interval -> crosspart -> duplicate -> before -> after -> fillfields; fillfields -> restore -> fill20 -> stage2 -> upload2; upload2 -> post -> getwrank -> getpost1 -> classify -> rankmap -> infer -> compare -> known; known -> same -> resultpost; known -> conflict -> resultpost; known -> unknown -> resultpost; known -> unknownrank -> resultpost; resultpost -> manualpost -> uploadpost -> check -> checkw -> checks -> checkr -> check20 -> checkpost -> final;
}
